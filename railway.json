{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "services/audit-api/Dockerfile",
    "rootDirectory": "."
  },
  "deploy": {
    "startCommand": "php -S 0.0.0.0:${PORT:-8080} -t /app",
    "healthcheckPath": "/",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
